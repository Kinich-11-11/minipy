[{"name":"G1 无参 set()","tag":"T","code":"s = set()\nprint(len(s))"},{"name":"G2 空列表 set([])","tag":"T","code":"s = set([])\nprint(len(s))\nprint(s)"},{"name":"G3 issubset","tag":"T","code":"print({1}.issubset({1, 2}))"},{"name":"G4 集合相等（乱序）","tag":"T","code":"print({1, 2} == {2, 1})"},{"name":"G5 集合不相等","tag":"T","code":"print({1, 2} == {1, 3})"},{"name":"G6 不等号","tag":"T","code":"print({1, 2} != {2, 1})"},{"name":"G7 子集","tag":"T","code":"print({1} <= {1, 2})\nprint({1} < {1, 2})\nprint({1, 2} < {1, 2})"},{"name":"G8 超集","tag":"T","code":"print({1, 2} >= {1})\nprint({1, 2} > {1, 2})"},{"name":"G9 集合比大小（不支持的关系）","tag":"T","code":"print({1, 2} <= {1})"}]

