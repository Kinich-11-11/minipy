[{"name":"map lambda","code":"print(list(map(lambda x: x + 1, [1, 2])))"},{"name":"map lambda mul","code":"print(list(map(lambda x: x * 2, [1, 2])))"},{"name":"filter lambda","code":"print(list(filter(lambda x: x > 1, [0, 1, 2])))"},{"name":"filter none keep","code":"print(list(filter(None, [0, 1, 2, 0])))"},{"name":"map str still","code":"print(list(map(str, [1, 2])))"},{"name":"map len","code":"print(list(map(len, [\"a\", \"ab\"])))"},{"name":"map var lambda","code":"f = lambda x: x + 10\nprint(list(map(f, [1, 2])))"},{"name":"map noncallable","code":"print(list(map(5, [1, 2])))"},{"name":"lambda forms","code":"print((lambda: 42)())\nprint((lambda x, y: x * y)(3, 4))\nprint(sorted([(2, chr(39)+chr(98)+chr(39)), (1, chr(39)+chr(97)+chr(39))], key=lambda p: p[0]))\nprint(list(map(lambda x: x + 1, [1, 2])))"},{"name":"builtin map filter reduced","code":"print(list(map(str, [1, 2])), list(map(lambda x: x * 2, [1, 2])))\nprint(list(filter(None, [0, 1, 2])))"}]