[{"name": "ord chr", "code": "print(ord('A'), chr(66), ord('жа'), chr(0x4e2d))"}, {"name": "isalpha", "code": "print('ab'.isalpha(), 'a1'.isalpha(), '12'.isdigit())"}, {"name": "sort method", "code": "a=[3,1,2]\na.sort()\nprint(a)\na.reverse()\nprint(a)"}, {"name": "super", "code": "class A:\n    def f(self):\n        return 'A'\nclass B(A):\n    def f(self):\n        return super().f() + 'B'\nprint(B().f())"}, {"name": "update", "code": "d={'a':1}\nd.update({'b':2})\nprint(sorted(d.items()))"}, {"name": "slice assign", "code": "a=[1,2,3,4,5]\na[1:3]=[9]\nprint(a)"}, {"name": "setdefault", "code": "d={}\nprint(d.setdefault('k', 5), d)"}, {"name": "sorted key", "code": "print(sorted(['bb','a','ccc'], key=len))"}, {"name": "list extend+", "code": "a=[1]\na.extend([2,3])\nprint(a, [1]+[2])"}, {"name": "dict del", "code": "d={'a':1,'b':2}\ndel d['a']\nprint(d)"}, {"name": "str in", "code": "print('ell' in 'hello', 'x' not in 'abc')"}, {"name": "enumerate", "code": "for i,v in enumerate(['a','b']):\n    print(i,v)"}, {"name": "zip dict", "code": "print(list(zip([1,2],['a','b'])))"}, {"name": "map filter", "code": "print(list(map(str,[1,2])), list(filter(lambda x:x>1,[1,2,3])))"}, {"name": "ternary", "code": "x=5\nprint('big' if x>3 else 'small')"}, {"name": "chained cmp", "code": "print(1 < 2 < 3, 3 > 2 > 5)"}, {"name": "global", "code": "n = 0\ndef f():\n    global n\n    n += 1\nf()\nf()\nprint(n)"}, {"name": "tuple unpack", "code": "a,b = 1,2\nprint(a,b)\n(a,b) = (b,a)\nprint(a,b)"}, {"name": "star unpack", "code": "a,*b = [1,2,3]\nprint(a,b)"}, {"name": "dict comp", "code": "print({k:k*k for k in range(3)})"}, {"name": "set ops", "code": "a={1,2,3}\nb={2,3,4}\nprint(sorted(a|b), sorted(a&b), sorted(a-b))"}, {"name": "format", "code": "print('{} {}'.format(1, 'x'), '{0}-{0}'.format(7))"}, {"name": "fstring fmt", "code": "x=3.14159\nprint(f'{x:.2f}', f'{42:05d}', f'{255:x}')"}, {"name": "__len__", "code": "class A:\n    def __len__(self):\n        return 3\nprint(len(A()))"}, {"name": "__getitem__", "code": "class A:\n    def __getitem__(self, i):\n        return i*2\nprint(A()[5])"}, {"name": "__eq__", "code": "class A:\n    def __init__(self,v):\n        self.v=v\n    def __eq__(self,o):\n        return self.v==o.v\nprint(A(1)==A(1), A(1)!=A(2))"}, {"name": "wrapped except", "code": "try:\n    raise ValueError('boom')\nexcept (TypeError, ValueError) as e:\n    print(type(e).__name__, e)"}, {"name": "isinstance", "code": "print(isinstance(1, int), isinstance(1.0, (int,float)), isinstance('s', str))"}, {"name": "round/abs", "code": "print(round(2.675,2), abs(-3), max(3,1,2), min([4,2,9]))"}, {"name": "id alias", "code": "a=[1]\nb=a\nprint(a is b, a == [1])"}, {"name": "neg index", "code": "a=[1,2,3]\nprint(a[-1], a[-2:], a[::-1])"}, {"name": "string mul", "code": "print('ab'*3, '-'*5)"}, {"name": "pow mod", "code": "print(pow(3, 100, 7))"}, {"name": "divmod", "code": "print(divmod(17,5))"}, {"name": "nested try", "code": "try:\n    try:\n        raise KeyError('k')\n    finally:\n        print('fin')\nexcept KeyError as e:\n    print('caught', e)"}, {"name": "nonlocal", "code": "def outer():\n    n=0\n    def inc():\n        nonlocal n\n        n+=1\n        return n\n    return inc\ng=outer()\nprint(g(), g())"}]