$root = 'D:/编程/scratch/ai/minipython'# every entry lists the patches to SKIP when rebuilding that older version#   v4.24 = P46+P47+P49 ; v4.25 = +P33+P48 ; v4.26 = +P51 ; v4.27 = +P52 ; v4.28 = +P54#   v4.29 = +P55 (classes) ; v4.30 = +P56 (demo/help, Controller target) + P57 (class calls, ~)#   v4.31 = +P58 (panel values) + P59 (dicts / instances) + P60 (comprehension scope)#           + P61 (step into functions) + P62 (self scope) + P65 (debug state) + P66 (non-warp chain)#   v4.32 = +P67 (printargs/minmax/regdef + closure check)#   v4.33 = +P68 (RUN goes through warp copies of callfn/callmeth, STEP stays non-warp)#   v4.34 = +P70 (bitwise augmented assign) + P71 (numeric literals) + P72 (\n \t)#           + P73 (semicolon) + P74 (list + / *) + P75 (more str methods)#           + P76 (None returns, type()) + P77 (%-format width/precision + f-string spec)#           + P78 (min/max(iterable), int(x, base))#   v4.35 = +P79 (d[k]=v / del d[k]) + P80 (len(d) / k in d / for k in d)#           + P81 (slice step) + P82 (str.format)#   v4.36 = +P83 (bare comma tuple) + P84 (unpack from a container)#           + P85 (functions as values) + P86 (callee survives calls in the arguments)#   v4.37 = +P87 (import math as m, math.pi/e) + P88 (try/else) + P89 (for a, b in ...)#   v4.38 = +P90 (class attributes, __str__) + P91 (dict methods)#   v4.39 = +P93 (brace-aware depth scans) + P92 (postfix chains over an expression)#           + P94 (one pow kernel: integer/half exponents are exact)#   v4.40 = +P95 (augmented assignment to an attribute or a subscript)#           + P96 (a loop that ends a function body really iterates)#           + P97 (a generator can drive a for loop)#   v4.41 = +P98 (a comprehension inside a comprehension) + P99 (enumerate / zip)#   v4.42 = +P100 (keyword arguments) + P101 (sorted(x, reverse=...))#           + P102 (the unpack branch needs its own LoopName reporter)#   v4.44 = +P105 (*args / **kwargs) + P106 (class inheritance)#   v4.45 = +P107 (try/finally) + P108 (dict comprehension) + P109 (dictfmt re-entrant)#           + P110 (a dict lookup must only compare key records) + P111 (sets)#   v4.46 = +P112 (except ... as name) + P113 (a set answers len/in/for)#           + P114 (sum/sorted/list/min/max accept a set)#   v4.47 = +P115 (split() splits on whitespace) + P116 (yield a, b)#           + P118 (attribute error wording)#   v4.48 = +P117 (dict pop rebuilt) + P120 (one argument reporter per use)#   v4.49 = +P121 (float literals: accurate negative exponents, scientific notation)#           + P122 (float repr: fixed/scientific switch, -0.0, float())#   v4.50 = +P123 (return/break/continue inside a try run the finally tail first;#           try/except/finally keeps a tail frame too)#   v4.51 = +P124 (set methods add/remove/discard/clear/update/union/intersection/difference/#           symmetric_difference/copy/isdisjoint + set operators | & - ^ + set() + 	 = s aliasing)#   v4.53 = +P126 (generator expressions; unpacking a generator)#   v4.52 = +P125 (multi-clause comprehensions: [e for a in A for b in B if c], for lists,#           sets and dicts; repeated dict keys keep the last value; P60 scoping re-applied)#   v4.67 = +P140 (tuple index/count; undefined names inside except clauses)#   v4.68 = +P141 (non-callable values, attribute errors, method receiver state)#   v4.69 = +P142 (zero-argument calls)#   v4.70 = +P143 (tuple(x) and range(...) as expressions)#   v4.71 = +P144 (dict(x) from a sequence of pairs)#   v4.72 = +P145 (percent formatting flags / x o r c / error cases)#   v4.73 = +P146 (%e, * width, indentation message)#   v4.74 = +P147 (percent mapping form)#   v4.75 = +P148 (dict keyword arguments)#   v4.76 = +P149 (a dict iterates as its keys)#   v4.77 = +P150 (str.format keyword arguments; the receiver is captured before the arguments)#   v4.78 = +P151 (format specs for .format fields and f-strings)#   v4.79 = +P152 (g/G general format, b binary, the % type)#   v4.80 = +P153 (!r/!s conversion and ,/_ grouping)#   v4.81 = +P154 (# prefixes, !r/!s in f-strings, integer check for x/o/X/b)#   v4.82 = +P155 (attribute/subscript paths in format fields, braces in the argument scan)#   v4.83 = +P156 (format error wording + missing-field errors)#   v4.84 = +P157 (dict(**d) unpacking, sum(d) over the keys)#   v4.85 = +P158 (free space-based indentation width)#   v4.86 = +P159 (tab characters: checkASCII, indentation, tokenizer)#   v4.87 = +P160 (nested fields inside a format spec)#   v4.126 = +P199 (special keys come from the keyboard through `key (join c "") pressed?`;#           the on-screen keypad becomes one row: TAB / ENTER / BACKSPACE / CASE / SPEED)#   v4.127 = +P200 (the rest of the string interface: the `end` bound of find/rfind/count/index for#           str, list and tuple, a negative `start`, split(None, maxsplit), and rsplit)#   v4.128 = +P201 (the rest of the string-*method arguments*: replace(old,new,count) and the empty#           pattern, startswith/endswith with a start/end region, None as "not given", and#           non-integer position arguments rejected with CPython's wording)#   v4.129 = +PUNDO (the undo key keeps 50 frames, a run closes every 10 characters or#           2s of silence, and Code never goes to 0 lines)#           +PFONT (bigger text in the code / console / variables panels: pitch 5.1 -> 5.87,#           size 100 -> 115, 44 / 26 / 23 columns, and the click + hscroll constants#           that follow the pitch; the row shadow is re-centred on the text)#           +PCLIP (drag to select, COPY / PASTE in a second button row, the selection#           drawn as a band, and EXPORT/IMPORT switching to \n with escaped backslashes)#   v4.130 = +P202 (auto-indent on ENTER: the new line inherits the indentation of the#           text before the cursor and goes one level deeper when that text ends with a#           colon, ignoring anything after a #; ENTER on a blank line drops to column 0)#   v4.131 = +P203 (raise the six hard limits: 1000 lines / 2000 chars per line /#           16384-char value / 2000 console lines / recursion 512 + expression#           depth 768 / 50000+450000*speed steps / 100000 steps per call)#   v4.132 = +P204 (empty list/dict/tuple/set are falsy: `truth` tests the record string#           instead of `== 0`, which Scratch deliberately does not treat as equal)#           +P205 (`bool(x)` carries the bool type tag, so it prints True/False)#           +P206 (`xs.sort(reverse=True)` really sorts descending; lsort gained a#           direction flag and methodcall reads the keyword out of the argument tokens)#         (add a new patch instead), so older artifacts stay reproducible.#   v4.133 = +P207 (`d[k] = v` on an existing key spliced one separator too far and ate the#           next pair: the guard was `lcount == (dgf+1)+2` instead of `dgf+2`)#           +P208 (indexset keeps its receiver/key/value in private `is*` variables, so a#           nested eval of the key or of the value can no longer clobber them)#           +P209 (the float promotion in `rightside` fired on `contains(text,".")` alone,#           so a quoted string containing a dot was retyped as a number and `'1.5' in '1.5'`#           raised "in requires strings"; it now requires a numeric operand)#           +P210 (type()'s `<class '...'>` ladder tested `contains(ev,".")` after the bare#           ladder had overwritten `ev` with the word "float", so every float read `<class 'int'>`)#   v4.134 = +P211 (`**` is right-associative and binds tighter than a leading unary sign:#           the cut scan kept the RIGHTMOST operator of the lowest rank, so `2**3**2` was#           `(2**3)**2` and `-2**2` was `(-2)**2`)#           +P212 (`trimsp` only stripped a literal space, so strip/lstrip/rstrip left tabs#           and newlines behind)#           +P213 (string escapes: `\r \v \f \a \b` decoded to the bare letters)#           +P214 (repr() neither escaped nor chose its quote: `repr('\n')` printed a raw#           newline and `repr("it's")` printed `'''it's'''`)#   v4.135 = +P215 (`compareText` compared characters by costume NUMBER, so any character#           without a glyph (every control character) silently compared EQUAL: CR/TAB broke#           find/count/split/replace/`in`; non-glyph characters now compare by code unit)#           +P216 (a doubled closing brace in an f-string produced two braces: `f'{{a}}'`#           printed `{a}}`)#   v4.136 = +P217 (`rightside` re-tagged an arithmetic result as a float only when the#           operands *still* carried a dot at the end -- but `ev` already held the result, so#           `1 + 1.0` printed `2` and `2 * 1.5` printed `3`; the flag is now taken in the#           prologue, and `+` joins the numeric operator list)#           +P218 (the numeric builtins dropped the dot as well: `sum([1.5,2.5])` -> 4,#           `abs(-2.0)` -> 2, `divmod(7.0,2.0)` -> `(3, 1)`, `round(2.0,1)` -> 2)#   v4.137 = +P219 (`print(sep=..., end=...)` together printed the separator as a one-element#           tuple -- the token before `end` is the comma, and it was inside the evaluated#           range; `str.zfill()` padded in front of the sign (`'-42'.zfill(5)` -> `00-42`);#           the precision of `%s` was parsed and ignored; `sum()`/`abs()` rejected booleans)#   v4.138 = +P220 (repr() spells BEL/VT/FF as `\xhh`; `startswith`/`endswith` accept a tuple#           of prefixes -- a container first argument was compared by its record-string#           length and never matched, and any other non-string now raises the TypeError#           CPython raises.  Also: scratch-vm drops a literal U+0008 when loading a project,#           so P213's `\b` mapping turned `'\b'` into the EMPTY string; it now stays `b`)#   v4.139 = +P221 (extended slice assignment [i:j:k] = seq was a SyntaxError: the stop range#           ran from the first colon to ] and therefore contained the second colon.#           indexset now records the second colon and routes stepped targets to a new#           sliceset proc that follows CPython's slice.indices(n) and its length error)$p139 = 'P221'$p138 = 'P220'$p137 = 'P219'$p136 = 'P217,P218'$p135 = 'P215,P216'$p134 = 'P211,P212,P213,P214'$p133 = 'P207,P208,P209,P210'$p132 = 'P204,P205,P206'$p130 = 'P202'$p131 = 'P203'$p129 = 'PUNDO,PFONT,PCLIP'$p128 = 'P201'$p127 = 'P200'$p126 = 'P199'$p125 = 'P198'$p124 = 'P197'$p123 = 'P196'$p122 = 'P195'$p121 = 'P194'$p120 = 'P193'$p119 = 'P192'$p118 = 'P191'$p117 = 'P190'$p116 = 'P189'$p115 = 'P188'$p114 = 'P187'$p113 = 'P186'$p112 = 'P185'$p111 = 'P184'$p110 = 'P183'$p109 = 'P182'$p108 = 'P181'$p107 = 'P180'$p106 = 'P179'$p105 = 'P178'$p104 = 'P177'$p103 = 'P176'$p102 = 'P175'$p101 = 'P174'$p100 = 'P173'$p99 = 'P172'$p98 = 'P171'$p97 = 'P170'$p96 = 'P169'$p95 = 'P168'$p94 = 'P167'$p93 = 'P166'$p92 = 'P165'$p91 = 'P164'$p90 = 'P163'$p89 = 'P162'$p88 = 'P161'$p87 = 'P160'$p86 = 'P159'$p85 = 'P158'$p84 = 'P157'$p83 = 'P156'$p82 = 'P155'$p81 = 'P154'$p80 = 'P153'$p79 = 'P152'$p78 = 'P151'$p77 = 'P150'$p76 = 'P149'$p75 = 'P148'$p74 = 'P147'$p73 = 'P146'$p72 = 'P145'$p71 = 'P144'$p70 = 'P143'$p69 = 'P142'$p68 = 'P141'$p67 = 'P140'$p66 = 'P139'$p65 = 'P138'$p64 = 'P137'$p63 = 'P136'$p62 = 'P135'$p61 = 'P134'$p60 = 'P133'$p59 = 'P132'$p58 = 'P131'$p57 = 'P130'$p56 = 'P129'$p55 = 'P128'$p54 = 'P127'$p53 = 'P126'$p52 = 'P125'$p51 = 'P124'$p50 = 'P123'$p49 = 'P121,P122'$p48 = 'P117,P120'$p47 = 'P115,P116,P118'$p46 = 'P112,P113,P114'$p45 = 'P107,P108,P109,P110,P111'$p44 = 'P105,P106'$p43 = 'P103,P104'$p42 = 'P100,P101,P102'$p41 = 'P98,P99'$p40 = 'P95,P96,P97'$p39 = 'P92,P93,P94'$p38 = 'P90,P91'$p37 = 'P87,P88,P89'$p36 = 'P83,P84,P85,P86'$p35 = 'P79,P80,P81,P82'$p34 = 'P70,P71,P72,P73,P74,P75,P76,P77,P78'$old = "$p36,$p35,$p34"$old2 = "$p37,$old"$all = "$p49,$p48,$p47,$p46,$p45,$p44,$p43,$p42,$p41,$p40,$p39,$p38,$old2"$map = [ordered]@{  'v4.138' = "$p139"  'v4.137' = "$p138"  'v4.136' = "$p138,$p137"  'v4.135' = "$p138,$p137,$p136"  'v4.134' = "$p138,$p137,$p136,$p135"  'v4.133' = "$p138,$p137,$