["def qs(a):","    if len(a) <= 1:","        return a","    p = a[0]","    left = []","    right = []","    for x in a[1:]:","        if x < p:","            left.append(x)","        else:","            right.append(x)","    r1 = qs(left)","    print(a, p, left, right, r1)","    r2 = qs(right)","    return r1 + [p] + r2","print(qs([8, 3, 9, 1, 5, 5, 2, 7]))"]