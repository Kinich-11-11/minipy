["class MyErr(Exception):","    def __init__(self, code, msg):","        Exception.__init__(self, msg)","        self.code = code","        self.msg = msg","def check(v):","    if v < 0:","        raise MyErr(400, 'negative' + str(v))","    return v * 2","try:","    print(check(-3))","except MyErr as e:","    print(e.code, e.msg, str(e))"]