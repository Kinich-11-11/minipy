["class Vec:","    def __init__(self, x, y):","        self.x = x","        self.y = y","    def __add__(self, other):","        return Vec(self.x + other.x, self.y + other.y)","    def __repr__(self):","        return '(' + str(self.x) + ',' + str(self.y) + ')'","v1 = Vec(1, 2)","v2 = Vec(3, 4)","print(v1 + v2)"]